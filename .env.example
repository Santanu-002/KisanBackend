# Application Configuration
PROJECT_NAME="Kisan Backend"
API_V1_STR="/api/v1"

# Database Configuration
# Use 'db' if running via docker-compose, 'localhost' if running locally
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kisan_db

# Redis Configuration
# Use 'redis' if running via docker-compose, 'localhost' if running locally
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security (Change these in production!)
SECRET_KEY=yoursecretkeyhere-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Configuration
SMS_PROVIDER=mock  # Options: mock, twilio
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_SECONDS=600

# Twilio Credentials (Optional - only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# Mobile App Configuration
ANDROID_APP_HASH=your_android_app_hash

# Test Account (Master OTP)
# Phone: +9111111111111
# OTP: 222222

# Cloudflare R2 Configuration
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your_bucket_name
S3_REGION=auto
S3_PUBLIC_URL_PREFIX=https://pub-<id>.r2.dev/your_bucket
